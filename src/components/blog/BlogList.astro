---
import BlogCard from './BlogCard.astro';

interface Post {
  id: string;
  data: {
    title: string;
    description: string;
    publishDate: Date;
    tags: string[];
    featured?: boolean;
  };
}

interface Props {
  posts: Post[];
  columns?: 1 | 2 | 3;
}

const { posts, columns = 2 } = Astro.props;

const gridCols = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 md:grid-cols-2',
  3: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3',
};

// Separate featured and regular posts
const featuredPosts = posts.filter(p => p.data.featured);
const regularPosts = posts.filter(p => !p.data.featured);
---

<div class="space-y-8">
  <!-- Featured Posts -->
  {
    featuredPosts.length > 0 && (
      <section>
        <h2 class="text-xl font-semibold text-text-primary mb-4">Featured</h2>
        <div class={`grid ${gridCols[columns]} gap-6`}>
          {featuredPosts.map(post => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              slug={post.id}
              publishDate={post.data.publishDate}
              tags={post.data.tags}
              featured={true}
            />
          ))}
        </div>
      </section>
    )
  }

  <!-- Regular Posts -->
  {
    regularPosts.length > 0 && (
      <section>
        {featuredPosts.length > 0 && (
          <h2 class="text-xl font-semibold text-text-primary mb-4">All Posts</h2>
        )}
        <div class={`grid ${gridCols[columns]} gap-6`}>
          {regularPosts.map(post => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              slug={post.id}
              publishDate={post.data.publishDate}
              tags={post.data.tags}
            />
          ))}
        </div>
      </section>
    )
  }

  <!-- Empty State -->
  {
    posts.length === 0 && (
      <div class="text-center py-12">
        <p class="text-text-muted">No posts yet.</p>
      </div>
    )
  }
</div>
