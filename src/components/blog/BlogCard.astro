---
import Card from '../ui/Card.astro';

interface Props {
  title: string;
  description: string;
  slug: string;
  publishDate: Date;
  tags: string[];
  featured?: boolean;
}

const { title, description, slug, publishDate, tags, featured = false } = Astro.props;

const formattedDate = publishDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article>
  <a href={`/blog/${slug}`} class="group block h-full">
    <Card
      variant={featured ? 'bordered' : 'default'}
      class="h-full hover:border-accent transition-colors p-6"
    >
      <div class="flex flex-col h-full">
        <!-- Tags -->
        {
          tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-3">
              {tags.map(tag => (
                <span class="px-2 py-1 text-xs font-medium bg-accent-subtle text-accent rounded-full">
                  {tag}
                </span>
              ))}
            </div>
          )
        }

        <!-- Title -->
        <h3
          class="text-lg font-semibold text-text-primary group-hover:text-accent transition-colors mb-2 line-clamp-2"
        >
          {title}
        </h3>

        <!-- Description -->
        <p class="text-text-secondary text-sm line-clamp-3 mb-4 flex-grow">
          {description}
        </p>

        <!-- Footer -->
        <div class="flex items-center justify-between pt-4 border-t border-border">
          <time class="text-text-muted text-sm" datetime={publishDate.toISOString()}>
            {formattedDate}
          </time>
          <span
            class="text-accent text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity"
          >
            Read more →
          </span>
        </div>
      </div>
    </Card>
  </a>
</article>
