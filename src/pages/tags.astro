---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const allTags = [...new Set(posts.flatMap(post => post.data.tags))].sort();

const tagCounts = allTags.map(tag => ({
  tag,
  count: posts.filter(post => post.data.tags.includes(tag)).length,
  posts: posts.filter(post => post.data.tags.includes(tag))
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
}));
---

<Layout title="Tags | XSun">
  <div class="space-y-16">
    <div class="space-y-6">
      <h1 class="text-6xl font-bold bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-400 bg-clip-text text-transparent">
        Tags
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-400">
        Browse posts by topic
      </p>
    </div>

    <div class="flex flex-wrap gap-4">
      {tagCounts.map(({ tag, count }) => (
        <a 
          href={`#${tag}`}
          class="px-5 py-3 rounded-xl bg-gradient-to-r from-blue-500/10 to-cyan-500/10 border border-blue-500/20 hover:border-blue-500/40 hover:shadow-lg hover:shadow-blue-500/10 transition-all duration-300"
        >
          <span class="font-semibold text-blue-600 dark:text-blue-400">{tag}</span>
          <span class="ml-2 text-sm text-gray-500 dark:text-gray-400">({count})</span>
        </a>
      ))}
    </div>

    <div class="space-y-16">
      {tagCounts.map(({ tag, posts: tagPosts }) => (
        <section id={tag} class="space-y-6">
          <h2 class="text-3xl font-bold">{tag}</h2>
          <div class="grid gap-6">
            {tagPosts.map((post) => (
              <a href={`/blog/${post.slug}`} class="block group">
                <article class="p-6 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-blue-500/50 hover:shadow-lg hover:shadow-blue-500/10 transition-all duration-300 bg-white/50 dark:bg-black/30">
                  <h3 class="text-xl font-semibold mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    {post.data.title}
                  </h3>
                  <time class="text-sm text-gray-500 dark:text-gray-400">{post.data.date}</time>
                </article>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>

<style>
  .space-y-16 > * + * { margin-top: 4rem; }
  .space-y-6 > * + * { margin-top: 1.5rem; }
  .grid { display: grid; }
  .gap-6 { gap: 1.5rem; }
  .gap-4 { gap: 1rem; }
  
  html {
    scroll-behavior: smooth;
  }
</style>
