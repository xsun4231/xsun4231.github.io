---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const allTags = [...new Set(posts.flatMap(post => post.data.tags))].sort();
---

<Layout title="Blog | XSun">
  <div class="space-y-16">
    <div class="space-y-6">
      <h1 class="text-6xl font-bold bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-400 bg-clip-text text-transparent">
        Blog
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-400">
        {posts.length} posts about technology and programming
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      {allTags.map((tag) => (
        <a 
          href={`/tags#${tag}`}
          class="px-4 py-2 rounded-lg bg-gradient-to-r from-blue-500/10 to-cyan-500/10 border border-blue-500/20 hover:border-blue-500/40 hover:shadow-md hover:shadow-blue-500/10 transition-all duration-300 text-sm font-medium text-blue-600 dark:text-blue-400"
        >
          {tag}
        </a>
      ))}
    </div>

    <div class="grid gap-8">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="group block">
          <article class="p-8 rounded-2xl border border-gray-200 dark:border-gray-800 hover:border-blue-500/50 hover:shadow-xl hover:shadow-blue-500/10 transition-all duration-300 bg-white/50 dark:bg-black/30 backdrop-blur-sm">
            <div class="flex items-center gap-3 mb-4 text-sm text-gray-500 dark:text-gray-400">
              <time>{post.data.date}</time>
              <span class="w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-700"></span>
              <div class="flex gap-2">
                {post.data.tags.slice(0, 3).map((tag: string) => (
                  <span class="px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 text-xs font-medium">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
            <h2 class="text-2xl font-bold mb-3 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {post.data.title}
            </h2>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
              {post.data.excerpt}
            </p>
          </article>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .space-y-16 > * + * { margin-top: 4rem; }
  .space-y-6 > * + * { margin-top: 1.5rem; }
  .grid { display: grid; }
  .gap-8 { gap: 2rem; }
  .gap-3 { gap: 0.75rem; }
</style>
