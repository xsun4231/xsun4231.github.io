---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogList from '../../components/blog/BlogList.astro';

const posts = await getCollection('blog');
const sortedPosts = posts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

// Extract all unique tags
const allTags = [...new Set(posts.flatMap(post => post.data.tags))].sort();
---

<BaseLayout
  title="Blog - XSun"
  description="All blog posts about web development, technology, and programming"
>
  <!-- Hero Section -->
  <section class="py-16 md:py-24 border-b border-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-4">Blog</h1>
      <p class="text-xl text-text-secondary">
        {sortedPosts.length} articles about web development and technology
      </p>
    </div>
  </section>

  <!-- Tags Section -->
  {
    allTags.length > 0 && (
      <section class="py-8 border-b border-border">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex flex-wrap gap-2">
            <span class="text-text-muted text-sm mr-2 py-2">Topics:</span>
            {allTags.map(tag => (
              <a
                href={`/tags/${tag.toLowerCase()}`}
                class="px-3 py-1.5 text-sm bg-accent-subtle text-accent rounded-full hover:bg-accent hover:text-white transition-colors"
              >
                {tag}
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Posts Grid -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <BlogList posts={sortedPosts} columns={2} />
    </div>
  </section>
</BaseLayout>
