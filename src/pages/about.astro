---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | XSun">
  <div class="max-w-3xl space-y-20">
    <div class="space-y-8">
      <h1 class="text-6xl font-bold bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-400 bg-clip-text text-transparent">
        About Me
      </h1>
      <div class="h-1 w-24 rounded-full bg-gradient-to-r from-blue-600 to-cyan-500"></div>
    </div>

    <section class="space-y-6">
      <h2 class="text-3xl font-bold">Introduction</h2>
      <div class="space-y-4 text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
        <p>
          I'm a software developer focused on building elegant and efficient web applications.
        </p>
        <p>
          I believe in writing clean code, embracing simplicity, and continuously learning new technologies.
        </p>
        <p>
          This blog is where I share my thoughts on programming, technology, and software development.
        </p>
      </div>
    </section>

    <section class="space-y-8">
      <h2 class="text-3xl font-bold">Skills & Technologies</h2>
      
      <div class="space-y-6">
        <div class="space-y-4">
          <h3 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Frontend</h3>
          <div class="flex flex-wrap gap-3">
            {['JavaScript', 'TypeScript', 'React', 'Next.js', 'Astro', 'Tailwind CSS'].map((skill) => (
              <span class="px-4 py-2 rounded-lg bg-gradient-to-r from-blue-500/10 to-cyan-500/10 border border-blue-500/20 text-sm font-medium hover:shadow-md hover:shadow-blue-500/10 transition-all duration-300">
                {skill}
              </span>
            ))}
          </div>
        </div>

        <div class="space-y-4">
          <h3 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Backend & Tools</h3>
          <div class="flex flex-wrap gap-3">
            {['Node.js', 'Python', 'Git', 'Docker'].map((skill) => (
              <span class="px-4 py-2 rounded-lg bg-gradient-to-r from-purple-500/10 to-pink-500/10 border border-purple-500/20 text-sm font-medium hover:shadow-md hover:shadow-purple-500/10 transition-all duration-300">
                {skill}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="space-y-6">
      <h2 class="text-3xl font-bold">Connect</h2>
      <div class="flex gap-6">
        <a
          href="https://github.com/xsun4231"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-lg bg-gradient-to-r from-gray-900 to-gray-700 dark:from-white dark:to-gray-200 text-white dark:text-black font-medium hover:shadow-lg hover:shadow-gray-900/20 transition-all duration-300"
        >
          GitHub Profile
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .space-y-20 > * + * { margin-top: 5rem; }
  .space-y-8 > * + * { margin-top: 2rem; }
  .space-y-6 > * + * { margin-top: 1.5rem; }
  .space-y-4 > * + * { margin-top: 1rem; }
</style>
