---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home" description="Welcome to XSun's personal website">
  <section class="py-20 text-center">
    <h1
      class="text-5xl font-bold mb-6 bg-gradient-to-r from-accent to-accent-hover bg-clip-text text-transparent"
    >
      Welcome to XSun
    </h1>
    <p class="text-xl text-text-secondary max-w-2xl mx-auto">
      A minimal, performance-focused personal website built with Astro and Tailwind CSS.
    </p>
  </section>
</BaseLayout>
