---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
).slice(0, 5);
---

<Layout>
  <div class="space-y-32">
    <section class="pt-12 pb-8">
      <div class="inline-block mb-6 px-4 py-1.5 rounded-full bg-gradient-to-r from-blue-500/10 to-cyan-500/10 border border-blue-500/20">
        <span class="text-sm font-medium bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent">
          Welcome
        </span>
      </div>
      <h1 class="text-7xl md:text-8xl font-bold tracking-tight mb-8 leading-none">
        <span class="bg-gradient-to-r from-gray-900 to-gray-600 dark:from-white dark:to-gray-400 bg-clip-text text-transparent">
          XSun
        </span>
      </h1>
      <p class="text-2xl md:text-3xl text-gray-600 dark:text-gray-400 max-w-3xl leading-relaxed">
        Building elegant solutions through clean code and thoughtful design
      </p>
    </section>

    <section class="space-y-12">
      <div class="flex items-baseline justify-between">
        <h2 class="text-4xl font-bold">Recent Writing</h2>
        <a 
          href="/blog" 
          class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 transition-colors group"
        >
          View all posts
          <span class="inline-block group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <div class="grid gap-8">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="group block">
            <article class="p-8 rounded-2xl border border-gray-200 dark:border-gray-800 hover:border-blue-500/50 dark:hover:border-blue-500/50 hover:shadow-lg hover:shadow-blue-500/10 transition-all duration-300 bg-white/50 dark:bg-black/30 backdrop-blur-sm">
              <div class="flex items-center gap-3 mb-4 text-sm text-gray-500 dark:text-gray-400">
                <time>{post.data.date}</time>
                <span class="w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-700"></span>
                <div class="flex gap-2">
                  {post.data.tags.slice(0, 2).map((tag: string) => (
                    <span class="px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 text-xs font-medium">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
              <h3 class="text-2xl font-bold mb-3 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {post.data.title}
              </h3>
              <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                {post.data.excerpt}
              </p>
            </article>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .space-y-32 > * + * { margin-top: 8rem; }
  .space-y-12 > * + * { margin-top: 3rem; }
  .grid { display: grid; }
  .gap-8 { gap: 2rem; }
</style>
