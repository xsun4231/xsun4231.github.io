---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import BlogList from '../components/blog/BlogList.astro';

const posts = await getCollection('blog');
const sortedPosts = posts
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 5);
---

<BaseLayout
  title="XSun - Developer & Blogger"
  description="Personal blog about web development, technology, and programming"
>
  <!-- Hero Section -->
  <section class="py-20 md:py-32">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-6xl font-bold text-text-primary mb-6 leading-tight">
          Hi, I'm <span class="text-accent">XSun</span>
        </h1>
        <p class="text-xl md:text-2xl text-text-secondary mb-8 leading-relaxed">
          A developer passionate about building elegant web experiences. I write about Astro,
          Tailwind CSS, and modern web development.
        </p>
        <div class="flex flex-wrap gap-4">
          <Button href="/blog" variant="primary" size="lg"> Read Blog </Button>
          <Button href="/about" variant="outline" size="lg"> About Me </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Posts Section -->
  <section class="py-16 border-t border-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-text-primary">Latest Posts</h2>
        <a href="/blog" class="text-accent hover:text-accent-hover transition-colors font-medium">
          View All Posts →
        </a>
      </div>

      <BlogList posts={sortedPosts} columns={2} />
    </div>
  </section>
</BaseLayout>
