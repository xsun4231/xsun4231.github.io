---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/ui/Card.astro';

const posts = await getCollection('blog');

// Count posts per tag
const tagCounts = posts.reduce(
  (acc, post) => {
    post.data.tags.forEach(tag => {
      acc[tag] = (acc[tag] || 0) + 1;
    });
    return acc;
  },
  {} as Record<string, number>
);

// Sort tags by count (descending)
const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="Tags - XSun" description="Browse all blog post tags">
  <section class="py-16 border-b border-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-4">Tags</h1>
      <p class="text-xl text-text-secondary">Browse posts by topic</p>
    </div>
  </section>

  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          sortedTags.map(([tag, count]) => (
            <a href={`/tags/${tag.toLowerCase()}`} class="group">
              <Card class="h-full hover:border-accent transition-colors p-6">
                <div class="flex items-center justify-between">
                  <h2 class="text-lg font-semibold text-text-primary group-hover:text-accent transition-colors">
                    {tag}
                  </h2>
                  <span class="text-sm text-text-muted bg-bg-primary px-2 py-1 rounded-full">
                    {count} post{count !== 1 ? 's' : ''}
                  </span>
                </div>
              </Card>
            </a>
          ))
        }
      </div>

      <div class="mt-12 text-center">
        <a href="/blog" class="text-accent hover:text-accent-hover transition-colors">
          ← Back to all posts
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
